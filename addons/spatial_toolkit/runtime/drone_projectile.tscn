[ext_resource type="Script" path="res://addons/spatial_toolkit/runtime/drone_projectile.gd" id="1_projectile"]

[sub_resource type="Shader" id="Shader_tracer"]
code = "shader_type spatial;
render_mode unshaded, depth_draw_never;

uniform float fade : hint_range(0.0, 1.0) = 1.0;
varying float along;

void vertex() {
	along = VERTEX.y + 0.5;
}

void fragment() {
	ALBEDO = mix(vec3(1.0, 0.28, 0.035), vec3(1.0, 0.92, 0.65), along);
	ALPHA = pow(clamp(along, 0.0, 1.0), 1.25) * fade;
}
"

