msgstr "facades.neon.colors должен содержать #RRGGBB."

msgid "facades.palette must contain known material names."
msgstr "facades.palette должен содержать известные имена материалов."

msgid "facades.technology must be an object."
msgstr "facades.technology должен быть объектом."

msgid "facades.technology.enabled must be a boolean."
msgstr "facades.technology.enabled должен быть bool."

msgid "id must be a non-empty string."
msgstr "id должен быть непустой строкой."

#, c-format
msgid "performance.%s has an invalid budget."
msgstr "performance.%s имеет неверный бюджет."

#, c-format
msgid "performance.%s is out of range."
msgstr "performance.%s имеет неверный диапазон."

msgid "schema_version must be 1."
msgstr "schema_version должен быть 1."

msgid "seed must be a finite integer."
msgstr "seed должен быть конечным целым числом."

msgid "target.preserve_source_geometry must be true."
msgstr "target.preserve_source_geometry должен быть true."

#, c-format
msgid "technology.%s is out of range."
msgstr "technology.%s имеет неверный диапазон."

msgid "technology.archetypes must contain known variants."
msgstr "technology.archetypes должен содержать известные варианты."

msgid "world_scale must be positive."
msgstr "world_scale должен быть положительным."

#, c-format
msgid "Unknown drone controller: %s"
msgstr "Неизвестный контроллер дрона: %s"

msgid "Attach the map root to the scene tree before adding flight."
msgstr "Добавьте корень карты в дерево сцены перед настройкой полёта."

msgid "Flight requires Generated geometry and OverviewCamera."
msgstr "Для полёта нужны геометрия Generated и камера OverviewCamera."

msgid "The existing flight overlay has no camera. The overlay was preserved."
msgstr "У существующего слоя полёта отсутствует камера. Слой сохранён."

msgid "An authored node already uses the name FlyPlayer. The node was preserved."
msgstr "Имя FlyPlayer уже используется пользовательским узлом. Узел сохранён."

msgid "The drone model must be a Node3D scene without physics bodies or areas."
msgstr "Модель дрона должна быть сценой Node3D без физических тел и областей."

msgid "Window frame and glass colours must be finite."
msgstr "Цвета рамы и стекла должны быть конечными."

msgid "Unknown distant window grille pattern."
msgstr "Неизвестный рисунок дальних окон."

msgid "The frame mesh must have finite dimensions and nonzero width and height in the XY plane."
msgstr "Меш рамы должен иметь конечные размеры и ненулевую ширину и высоту в плоскости XY."

msgid "The selected resource must be a map appearance profile."
msgstr "Выбранный ресурс должен быть профилем оформления карты."

msgid "Chunks"
msgstr "Чанки"

msgid "Filter chunks"
msgstr "Фильтр чанков"

msgid "No chunks match the filter."
msgstr "Нет чанков, подходящих под фильтр."

msgid "Select or create a world in Spatial."
msgstr "Выберите или создайте мир в Spatial."

msgid "World"
msgstr "Мир"

msgid "Squares saved. Open Chunks in the bottom dock to browse them."
msgstr "Квадраты сохранены. Откройте вкладку «Чанки» в нижнем доке."

msgid "Could not open the selected square."
msgstr "Не удалось открыть выбранный квадрат."

msgid "Select a square to preview."
msgstr "Выберите квадрат для предпросмотра."

msgid "Loading square preview…"
msgstr "Загрузка предпросмотра квадрата…"

msgid "Square preview unavailable."
msgstr "Предпросмотр квадрата недоступен."
