msgstr "Достигнут лимит запросов Overpass. Повторите загрузку этой области позже."

msgid "Proxy authentication failed (HTTP 407). Check the login and password."
msgstr "Ошибка авторизации на прокси (HTTP 407). Проверьте логин и пароль."

msgid "Invalid proxy URL. Use http://login:pass@server:port."
msgstr "Некорректный URL прокси. Используйте http://login:pass@server:port."

msgid "Could not connect to Overpass through the proxy."
msgstr "Не удалось подключиться к Overpass через прокси."

msgid "TLS verification failed through the proxy."
msgstr "Не удалось проверить TLS при подключении через прокси."

#, c-format
msgid "Overpass failed (HTTP %d, result %d). Retry later."
msgstr "Ошибка Overpass (HTTP %d, код результата %d). Повторите загрузку позже."

