msgstr "Сведения появятся после открытия квадрата."

msgid "Update world"
msgstr "Обновить мир"

msgid "Processes new and changed GeoJSON sources and saves the affected squares."
msgstr "Обрабатывает новые и изменённые GeoJSON из массива и сохраняет затронутые квадраты."

msgid "Merges the source files and saves a separate scene for each square."
msgstr "Сшивает исходники из массива и сохраняет отдельную сцену для каждого квадрата."

msgid "Assembles the saved squares of the selected world into a new gameplay scene."
msgstr "Собирает сохранённые квадраты выбранного мира в новую игровую сцену."

msgid "Select world.json in “Saved world”."
